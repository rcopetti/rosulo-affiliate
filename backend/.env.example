DATABASE_URL=postgresql+asyncpg://rosulo:rosulo@localhost:5432/rosulo_affiliate
# Optional: override the database used by pytest. If unset, tests use <DATABASE_URL database name>_test.
TEST_DATABASE_URL=
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SQS_QUEUE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Email: set EMAIL_BACKEND=ses and EMAIL_FROM to send via AWS SES
EMAIL_BACKEND=console
EMAIL_FROM=noreply@rosulo.dev
SES_REGION=us-east-1
FRONTEND_URL=http://localhost:5173

# Private encrypted affiliate document storage
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_REGION=us-east-1
# URL-safe base64 key; generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DOCUMENTS_ENCRYPTION_KEY=
DOCUMENTS_MAX_BYTES=10485760
